{
  "name": "farmandtravel-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Toprakla Yeniden / Farm & Travel — backend (Hono lambdalith, clean architecture)",
  "scripts": {
    "dev": "tsx watch src/local.ts",
