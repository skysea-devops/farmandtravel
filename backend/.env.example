# --- Local dev ---
NODE_ENV=development
PORT=8787

# PostgreSQL (docker-compose ile lokal)
DATABASE_URL=postgres://ft:ft@localhost:5432/farmandtravel

# Auth: geliştirmede JWT doğrulaması bypass edilir (DEV_FAKE_SUB ile).
# Prod'da Cognito JWKS ile doğrulanır.
AUTH_MODE=dev            # dev | cognito
DEV_FAKE_SUB=dev-user-1  # AUTH_MODE=dev iken sabit kullanıcı
COGNITO_REGION=eu-central-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# AI etiketleme (Bedrock). AI_MODE=stub → gerçek çağrı yapılmaz, kural tabanlı eşleme.
AI_MODE=stub             # stub | bedrock
BEDROCK_REGION=eu-central-1
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
